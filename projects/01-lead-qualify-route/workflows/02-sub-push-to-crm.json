{
  "name": "02 - Push to CRM (sub-workflow)",
  "nodes": [
    {
      "parameters": { "inputSource": "passthrough" },
      "id": "b2e4d3f1-0002-4000-8000-000000000001",
      "name": "When called by main workflow",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [0, 300]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose", "version": 2 },
                "conditions": [
                  { "id": "c1", "leftValue": "={{ $json.crm_target }}", "rightValue": "hubspot", "operator": { "type": "string", "operation": "equals" } }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "hubspot"
            },
            {
              "conditions": {
                "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose", "version": 2 },
                "conditions": [
                  { "id": "c2", "leftValue": "={{ $json.crm_target }}", "rightValue": "sheets", "operator": { "type": "string", "operation": "equals" } }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "sheets"
            }
          ]
        },
        "options": { "fallbackOutput": "extra" }
      },
      "id": "b2e4d3f1-0002-4000-8000-000000000002",
      "name": "Which CRM?",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "resource": "contact",
        "operation": "upsert",
        "email": "={{ $json.email }}",
        "additionalFields": {
          "firstName": "={{ $json.full_name.split(' ')[0] }}",
          "lastName": "={{ $json.full_name.split(' ').slice(1).join(' ') }}",
          "companyName": "={{ $json.company }}",
          "website": "={{ $json.website }}",
          "lifeCycleStage": "={{ $json.tier === 'hot' ? 'salesqualifiedlead' : ($json.tier === 'warm' ? 'lead' : 'subscriber') }}",
          "message": "={{ $json.message }}\n\n[AI score {{ $json.score }}/10, {{ $json.tier }}] {{ $json.reason }}\nNext: {{ $json.next_action }}"
        }
      },
      "id": "b2e4d3f1-0002-4000-8000-000000000003",
      "name": "HubSpot: upsert contact",
      "type": "n8n-nodes-base.hubspot",
      "typeVersion": 2.1,
      "position": [520, 140]
    },
    {
      "parameters": {
        "operation": "appendOrUpdate",
        "documentId": { "__rl": true, "mode": "list", "value": "" },
        "sheetName": { "__rl": true, "mode": "list", "value": "" },
        "columns": {
          "mappingMode": "autoMapInputData",
          "matchingColumns": ["email"],
          "value": {}
        },
        "options": {}
      },
      "id": "b2e4d3f1-0002-4000-8000-000000000004",
      "name": "Google Sheets: upsert row",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [520, 300]
    },
    {
      "parameters": {
        "jsCode": "// Unknown CRM target. Fail loudly so the error workflow catches it.\nconst t = $input.first().json.crm_target;\nthrow new Error(`Unknown crm_target: ${t}. Add a branch in 'Which CRM?' for it.`);"
      },
      "id": "b2e4d3f1-0002-4000-8000-000000000005",
      "name": "Unknown CRM: fail",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [520, 460]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "o1", "name": "crm_status", "value": "pushed", "type": "string" },
            { "id": "o2", "name": "crm_target", "value": "={{ $('When called by main workflow').first().json.crm_target }}", "type": "string" },
            { "id": "o3", "name": "email", "value": "={{ $('When called by main workflow').first().json.email }}", "type": "string" }
          ]
        },
        "includeOtherFields": false,
        "options": {}
      },
      "id": "b2e4d3f1-0002-4000-8000-000000000006",
      "name": "Return status",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [800, 220]
    }
  ],
  "connections": {
    "When called by main workflow": { "main": [[{ "node": "Which CRM?", "type": "main", "index": 0 }]] },
    "Which CRM?": {
      "main": [
        [{ "node": "HubSpot: upsert contact", "type": "main", "index": 0 }],
        [{ "node": "Google Sheets: upsert row", "type": "main", "index": 0 }],
        [{ "node": "Unknown CRM: fail", "type": "main", "index": 0 }]
      ]
    },
    "HubSpot: upsert contact": { "main": [[{ "node": "Return status", "type": "main", "index": 0 }]] },
    "Google Sheets: upsert row": { "main": [[{ "node": "Return status", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" },
  "pinData": {}
}
