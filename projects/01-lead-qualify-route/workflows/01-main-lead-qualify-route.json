      },
      "id": "a1f3c2e0-0001-4000-8000-000000000013",
      "name": "Push to CRM (warm)",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [2400, 200]
    },
    {
      "parameters": {
        "workflowId": { "__rl": true, "mode": "list", "value": "" },
        "options": {}
      },
      "id": "a1f3c2e0-0001-4000-8000-000000000014",
      "name": "Push to CRM (cold)",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [2400, 400]
    },
    {
      "parameters": {
        "authentication": "webhook",
        "content": "=🔥 HOT LEAD ({{ $('Merge lead + score').item.json.score }}/10)\n{{ $('Merge lead + score').item.json.full_name }} at {{ $('Merge lead + score').item.json.company }} ({{ $('Merge lead + score').item.json.website }})\nEmail: {{ $('Merge lead + score').item.json.email }}\nSays: \"{{ $('Merge lead + score').item.json.message }}\"\nWhy: {{ $('Merge lead + score').item.json.reason }}\nNext: {{ $('Merge lead + score').item.json.next_action }}",
        "options": {}
      },
      "id": "a1f3c2e0-0001-4000-8000-000000000015",
      "name": "Alert sales (Discord)",
      "type": "n8n-nodes-base.discord",
      "typeVersion": 2,
      "position": [2640, 0]
    },
    {
      "parameters": {
        "sendTo": "={{ $('Merge lead + score').item.json.email }}",
        "subject": "=Re: {{ $('Merge lead + score').item.json.company }} and your inbound lead process",
        "emailType": "text",
        "message": "=Hi {{ $('Merge lead + score').item.json.full_name.split(' ')[0] }},\n\nThanks for reaching out. You mentioned: \"{{ $('Merge lead + score').item.json.message }}\"\n\nThat is exactly the kind of problem we help with. Two quick questions so I can point you to the right thing:\n\n1. Roughly how many inbound leads do you get per month today?\n2. Which CRM are you using?\n\nReply here, or grab 20 minutes on my calendar: [calendar link]\n\nBest,\n[Your name]",
        "options": {}
      },
      "id": "a1f3c2e0-0001-4000-8000-000000000016",
      "name": "Follow-up email #1 (Gmail)",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [2640, 200]
    },
    {
      "parameters": {
        "authentication": "webhook",
        "content": "=ℹ️ Duplicate lead ignored: {{ $('Normalize lead').first().json.email }} (already in the lead table)",
        "options": {}
      },
      "id": "a1f3c2e0-0001-4000-8000-000000000017",
      "name": "Log duplicate (Discord)",
      "type": "n8n-nodes-base.discord",
      "typeVersion": 2,
      "position": [960, 480]
    }
