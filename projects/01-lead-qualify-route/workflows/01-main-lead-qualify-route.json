{
  "name": "02 - Lead Qualify & Route (main)",
  "nodes": [
    {
      "parameters": {
        "formTitle": "Request a demo",
        "formDescription": "Tell us about your situation. We reply within one business day.",
        "formFields": {
          "values": [
            { "fieldLabel": "Full name", "requiredField": true },
            { "fieldLabel": "Work email", "fieldType": "email", "requiredField": true },
            { "fieldLabel": "Company", "requiredField": true },
            { "fieldLabel": "Website" },
            { "fieldLabel": "What are you trying to solve?", "fieldType": "textarea", "requiredField": true }
          ]
        },
        "options": {}
      },
      "id": "a1f3c2e0-0001-4000-8000-000000000001",
      "name": "Lead form",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.2,
      "position": [0, 300],
      "webhookId": "lead-form-demo"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "f1", "name": "email", "value": "={{ $json['Work email'].toLowerCase().trim() }}", "type": "string" },
            { "id": "f2", "name": "full_name", "value": "={{ $json['Full name'].trim() }}", "type": "string" },
            { "id": "f3", "name": "company", "value": "={{ $json['Company'] }}", "type": "string" },
            { "id": "f4", "name": "website", "value": "={{ $json['Website'] || '' }}", "type": "string" },
            { "id": "f5", "name": "message", "value": "={{ $json['What are you trying to solve?'] }}", "type": "string" },
            { "id": "f6", "name": "source", "value": "web_form", "type": "string" },
            { "id": "f7", "name": "submitted_at", "value": "={{ $now.toISO() }}", "type": "string" },
            { "id": "f8", "name": "lead_id", "value": "={{ $json['Work email'].toLowerCase().trim() }}", "type": "string" },
            { "id": "f9", "name": "crm_target", "value": "hubspot", "type": "string" }
          ]
        },
        "includeOtherFields": false,
        "options": {}
      },
      "id": "a1f3c2e0-0001-4000-8000-000000000002",
      "name": "Normalize lead",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [240, 300]
    },
    {
      "parameters": {
        "operation": "get",
        "dataTableId": { "__rl": true, "mode": "list", "value": "" },
        "filters": {
          "conditions": [
            { "keyName": "email", "condition": "eq", "keyValue": "={{ $json.email }}" }
          ]
        },
        "options": {}
      },
      "id": "a1f3c2e0-0001-4000-8000-000000000003",
      "name": "Find existing lead",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "position": [480, 300],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose", "version": 2 },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.isEmpty() }}",
              "rightValue": "",
              "operator": { "type": "boolean", "operation": "true", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1f3c2e0-0001-4000-8000-000000000004",
      "name": "Is new lead?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [720, 300]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "r1", "name": "email", "value": "={{ $('Normalize lead').first().json.email }}", "type": "string" },
            { "id": "r2", "name": "full_name", "value": "={{ $('Normalize lead').first().json.full_name }}", "type": "string" },
            { "id": "r3", "name": "company", "value": "={{ $('Normalize lead').first().json.company }}", "type": "string" },
            { "id": "r4", "name": "website", "value": "={{ $('Normalize lead').first().json.website }}", "type": "string" },
            { "id": "r5", "name": "message", "value": "={{ $('Normalize lead').first().json.message }}", "type": "string" },
            { "id": "r6", "name": "source", "value": "={{ $('Normalize lead').first().json.source }}", "type": "string" },
            { "id": "r7", "name": "submitted_at", "value": "={{ $('Normalize lead').first().json.submitted_at }}", "type": "string" },
            { "id": "r8", "name": "lead_id", "value": "={{ $('Normalize lead').first().json.lead_id }}", "type": "string" },
            { "id": "r9", "name": "crm_target", "value": "={{ $('Normalize lead').first().json.crm_target }}", "type": "string" }
          ]
        },
        "includeOtherFields": false,
        "options": {}
      },
      "id": "a1f3c2e0-0001-4000-8000-000000000005",
      "name": "Restore lead",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [960, 200]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=You are an SDR assistant for a B2B SaaS company that sells to companies with 20 to 500 employees who have inbound lead volume problems.\n\nScore this inbound lead.\n\nLead:\n- Name: {{ $json.full_name }}\n- Email: {{ $json.email }}\n- Company: {{ $json.company }}\n- Website: {{ $json.website }}\n- Message: {{ $json.message }}\n\nRules:\n- Free email domains (gmail, yahoo, hotmail, outlook) lower the score.\n- A message describing a concrete business problem with numbers raises the score.\n- Students, agencies looking for partnership, and vendors pitching services are cold.\n\nReturn score 1 to 10, tier (hot = 8 to 10, warm = 5 to 7, cold = 1 to 4), icp_fit (true/false), a one-sentence reason, and next_action (one short sentence for the sales rep).",
        "hasOutputParser": true
      },
      "id": "a1f3c2e0-0001-4000-8000-000000000006",
      "name": "Qualify with AI",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.5,
      "position": [1200, 200]
    },
    {
      "parameters": {
        "modelName": "models/gemini-2.5-flash",
        "options": { "temperature": 0.2 }
      },
      "id": "a1f3c2e0-0001-4000-8000-000000000007",
      "name": "Gemini model",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1,
      "position": [1180, 420]
    },
    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"score\": { \"type\": \"number\" },\n    \"tier\": { \"type\": \"string\", \"enum\": [\"hot\", \"warm\", \"cold\"] },\n    \"icp_fit\": { \"type\": \"boolean\" },\n    \"reason\": { \"type\": \"string\" },\n    \"next_action\": { \"type\": \"string\" }\n  },\n  \"required\": [\"score\", \"tier\", \"icp_fit\", \"reason\", \"next_action\"]\n}"
      },
      "id": "a1f3c2e0-0001-4000-8000-000000000008",
      "name": "Structured output",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.2,
      "position": [1400, 420]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "m1", "name": "email", "value": "={{ $('Restore lead').item.json.email }}", "type": "string" },
            { "id": "m2", "name": "full_name", "value": "={{ $('Restore lead').item.json.full_name }}", "type": "string" },
            { "id": "m3", "name": "company", "value": "={{ $('Restore lead').item.json.company }}", "type": "string" },
            { "id": "m4", "name": "website", "value": "={{ $('Restore lead').item.json.website }}", "type": "string" },
            { "id": "m5", "name": "message", "value": "={{ $('Restore lead').item.json.message }}", "type": "string" },
            { "id": "m6", "name": "source", "value": "={{ $('Restore lead').item.json.source }}", "type": "string" },
            { "id": "m7", "name": "submitted_at", "value": "={{ $('Restore lead').item.json.submitted_at }}", "type": "string" },
            { "id": "m8", "name": "lead_id", "value": "={{ $('Restore lead').item.json.lead_id }}", "type": "string" },
            { "id": "m9", "name": "crm_target", "value": "={{ $('Restore lead').item.json.crm_target }}", "type": "string" },
            { "id": "m10", "name": "score", "value": "={{ $json.output.score }}", "type": "number" },
            { "id": "m11", "name": "tier", "value": "={{ $json.output.tier }}", "type": "string" },
            { "id": "m12", "name": "icp_fit", "value": "={{ $json.output.icp_fit }}", "type": "boolean" },
            { "id": "m13", "name": "reason", "value": "={{ $json.output.reason }}", "type": "string" },
            { "id": "m14", "name": "next_action", "value": "={{ $json.output.next_action }}", "type": "string" }
          ]
        },
        "includeOtherFields": false,
        "options": {}
      },
      "id": "a1f3c2e0-0001-4000-8000-000000000009",
      "name": "Merge lead + score",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1640, 200]
    },
    {
      "parameters": {
        "operation": "upsert",
        "dataTableId": { "__rl": true, "mode": "list", "value": "" },
        "filters": {
          "conditions": [
            { "keyName": "email", "condition": "eq", "keyValue": "={{ $json.email }}" }
          ]
        },
        "columns": { "mappingMode": "autoMapInputData", "value": {} },
        "options": {}
      },
      "id": "a1f3c2e0-0001-4000-8000-000000000010",
      "name": "Save lead",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "position": [1880, 200]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose", "version": 2 },
                "conditions": [
                  { "id": "s1", "leftValue": "={{ $json.tier }}", "rightValue": "hot", "operator": { "type": "string", "operation": "equals" } }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "hot"
            },
            {
              "conditions": {
                "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose", "version": 2 },
                "conditions": [
                  { "id": "s2", "leftValue": "={{ $json.tier }}", "rightValue": "warm", "operator": { "type": "string", "operation": "equals" } }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "warm"
            },
            {
              "conditions": {
                "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose", "version": 2 },
                "conditions": [
                  { "id": "s3", "leftValue": "={{ $json.tier }}", "rightValue": "cold", "operator": { "type": "string", "operation": "equals" } }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "cold"
            }
          ]
        },
        "options": {}
      },
      "id": "a1f3c2e0-0001-4000-8000-000000000011",
      "name": "Route by tier",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [2120, 200]
    },
    {
      "parameters": {
        "workflowId": { "__rl": true, "mode": "list", "value": "" },
        "options": {}
      },
      "id": "a1f3c2e0-0001-4000-8000-000000000012",
      "name": "Push to CRM (hot)",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [2400, 0]
    },
    {
      "parameters": {
        "workflowId": { "__rl": true, "mode": "list", "value": "" },
